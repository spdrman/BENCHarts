{
  "name": "@spdrman/bencharts",
  "version": "0.1.0",
  "description": "Benchmark results as SVG. Records in, a deterministic string out.",
  "keywords": [
    "benchmark",
    "chart",
    "svg",
    "deterministic"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/spdrman/BENCHarts.git"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "default": "./src/index.js"
    },
    "./package.json": "./package.json"
  },
  "types": "./types/index.d.ts",
  "files": [
    "src",
    "types",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node --test",
    "types": "tsc --emitDeclarationOnly",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "typescript": "5.6.3"
  },
  "author": "Roman Goldmann"
}
